{
  "name": "verzel-store-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Testes automatizados da entrega VZS-142 (cupom e frete grátis) da Verzel Store",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:bugs": "playwright test --grep @bug",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
