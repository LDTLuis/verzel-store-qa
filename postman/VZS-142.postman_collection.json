          "name": "BUG-01 - Frete cobrado com subtotal R$ 200,00",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   const body = pm.response.json();\n   pm.test(\"Status 200\", () => pm.response.to.have.status(200));\n   pm.test(\"Subtotal é 200\", () => pm.expect(body.subtotal).to.eql(200));\n   pm.test(\"CA06: frete grátis com subtotal = 200\", () => {\n       pm.expect(body.frete).to.eql(0);\n       pm.expect(body.freteGratis).to.be.true;\n   });\n   pm.test(\"Total = 200\", () => pm.expect(body.total).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
