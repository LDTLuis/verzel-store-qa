        {
          "name": "BUG-04a - Pedido aceito com nome sem letras",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Nome sem letras é recusado (422)\", () => pm.response.to.have.status(422));\r\npm.test(\"Código DADOS_INVALIDOS\", () => {\r\n    pm.expect(pm.response.json().erro?.codigo).to.eql(\"DADOS_INVALIDOS\");\r\n});\r\npm.test(\"Erro aponta o campo cliente.nome\", () => {\r\n    const campos = pm.response.json().erro?.campos?.map(c => c.campo) || [];\r\n    pm.expect(campos).to.include(\"cliente.nome\");\r\n});"
                ]
              }
            }
          ],
